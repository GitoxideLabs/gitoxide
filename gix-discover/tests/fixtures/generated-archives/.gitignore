# The fixture creates linked worktrees (`git worktree add`) whose
# `.git` files and `.git/worktrees/*/gitdir` entries store absolute paths into
# the host's working directory. Re-running the script on the test host produces
# the correct paths for that machine.
/make_basic_repo.tar

# Only the nested repository layout matters; regenerate it with the host's Git templates.
/make_nested_repos.tar

# Only the bare/worktree layout matters; regenerate it with the host's Git templates.
/make_ownership_repos.tar

# Linked-worktree metadata contains absolute paths into the temporary fixture directory.
/make_linked_ownership_repo.tar

# The detached-HEAD fixture is simple and fast to generate.
/make_detached_head_repo.tar

# Discovery does not need separately tracked archives for each object hash format.
/*_sha256.tar
